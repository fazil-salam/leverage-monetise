# Server Configuration
PORT=3000
BASE_COUNTER_OFFSET=14

# Optional: Airtable Integration (to sync with Airtable alongside local JSON database)
AIRTABLE_PAT=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Submissions

